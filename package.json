{
	"name": "dashboard-worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Read-only AWS Cost Audit dashboard — Bun + Hono server",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"db:migrate": "bun src/db/migrate.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
	},
	"dependencies": {
		"@aws-sdk/client-cloudwatch": "^3.1152.0",
		"@aws-sdk/client-cloudwatch-logs": "^3.1152.0",
		"@aws-sdk/client-cost-explorer": "^3.1152.0",
		"@aws-sdk/client-ec2": "^3.1152.0",
		"@aws-sdk/client-eks": "^3.1152.0",
		"@aws-sdk/client-elastic-load-balancing": "^3.1152.0",
		"@aws-sdk/client-elastic-load-balancing-v2": "^3.1152.0",
		"@aws-sdk/client-rds": "^3.1152.0",
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/client-secrets-manager": "^3.1152.0",
		"@aws-sdk/client-sts": "^3.1152.0",
		"docx": "^9.12.0",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/better-sqlite3": "^7.6.11",
		"@types/node": "^26.6.5",
		"better-sqlite3": "^11.7.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}