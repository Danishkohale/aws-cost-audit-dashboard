# Copy to `.env` (gitignored) and fill in.

# Enables the grounded LLM narrative layer (rules/llm.ts).
# Without it the audit still runs — findings keep their deterministic rule text.
OPENROUTER_API_KEY=

# Pin one model slug. Never use `openrouter/free` (a random router that makes
# report wording change between runs). Free slugs rotate availability — if the
# default starts returning 429, pick another `:free` model.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
